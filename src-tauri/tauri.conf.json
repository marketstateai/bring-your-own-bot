{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarketState Codex Connector",
  "version": "0.1.0",
  "identifier": "ai.marketstate.codex-connector",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MarketState Codex Connector",
        "width": 520,
        "height": 650,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/codex"],
    "icon": ["../ui/marketstate-logo-mark.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
